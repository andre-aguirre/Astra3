---
/** "See Astra3 in action": the demo video once CONFIG.demoVideoUrl is set, and the screenshot gallery with a lightbox. */
import { CONFIG } from '../config';
import { u } from '../lib/url';
---
<section class="block" aria-labelledby="h-see" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Screenshots</p><h2 id="h-see">See Astra3 in action</h2></div>
    {CONFIG.demoVideoUrl && (
      <div class="video reveal"><iframe src={CONFIG.demoVideoUrl} title="Astra3 demo" style="width:100%;aspect-ratio:16/9;border:0;display:block" allow="fullscreen" loading="lazy"></iframe></div>
    )}
    <div class="gallery reveal">
      {CONFIG.screenshots.map(([n, cap]) => (
        <button type="button" data-full={u(`/img/${n}-1600.webp`)} data-cap={cap}>
          <img loading="lazy" src={u(`/img/${n}-800.webp`)} width="800" height="430" alt={cap} />
          <span>{cap}</span>
        </button>
      ))}
    </div>
  </div>
</section>
<dialog class="lightbox" id="lightbox" aria-label="Screenshot">
  <img id="lbImg" alt="" />
  <div class="lb-bar"><p id="lbCap"></p><button class="btn btn-ghost btn-sm" id="lbClose" type="button">Close</button></div>
</dialog>
<script>
  const d = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lbImg') as HTMLImageElement;
  const cap = document.getElementById('lbCap')!;
  document.querySelectorAll<HTMLButtonElement>('.gallery button').forEach((b) => b.addEventListener('click', () => {
    img.src = b.dataset.full!; img.alt = b.dataset.cap!; cap.textContent = b.dataset.cap!; d.showModal();
  }));
  document.getElementById('lbClose')!.addEventListener('click', () => d.close());
  d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
</script>
