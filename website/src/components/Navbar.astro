---
import DownloadButton from './DownloadButton.astro';
import { CONFIG } from '../config';
import { ICON } from '../lib/icons';
import { u } from '../lib/url';
interface Props { current?: string }
const { current = '' } = Astro.props;
const links = [
  ['features', 'Features'], ['docs', 'Documentation'], ['download', 'Download'], ['research', 'Research'],
] as const;
---
<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href={u('/')} aria-label="Astra3 home"><img src={u('/img/logo-256.png')} alt="" width="28" height="28" />Astra3</a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {links.map(([k, label]) => <li><a href={u(`/${k}`)} aria-current={current === k ? 'page' : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-right">
      <a class="icon-btn" href={CONFIG.githubUrl} target="_blank" rel="noopener" aria-label="Astra3 on GitHub"><Fragment set:html={ICON.github} /></a>
      <DownloadButton size="sm" label="Download" icon={false} />
      <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu"><Fragment set:html={ICON.menu} /></button>
    </div>
  </div>
  <div class="mobile-menu" id="mobileMenu" hidden>
    <div class="wrap" style="height:auto;display:block">
      <ul>
        {links.map(([k, label]) => <li><a href={u(`/${k}`)}>{label}</a></li>)}
        <li><a href={u('/changelog')}>Changelog</a></li>
        <li><a href={CONFIG.githubUrl} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
      <DownloadButton />
    </div>
  </div>
</header>
<script>
  const nav = document.getElementById('nav')!;
  const btn = document.getElementById('menuBtn')!;
  const menu = document.getElementById('mobileMenu')!;
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  const close = () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-label', 'Open menu'); };
  btn.addEventListener('click', () => {
    const open = menu.hidden; menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { close(); btn.focus(); } });
  matchMedia('(min-width: 861px)').addEventListener('change', close);
</script>
