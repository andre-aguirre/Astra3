---
import PlatformButtons from './PlatformButtons.astro';
import PlatformNote from './PlatformNote.astro';
import { u } from '../lib/url';
---
<section class="block" style="padding-top:0">
  <div class="wrap">
    <div class="final reveal">
      <p class="eyebrow">Get Astra3</p>
      <h2>Run your first analysis in a few minutes.</h2>
      <p class="lede" style="margin-top:0">Install Astra3, point it at your PyMOL, and type a PDB ID.</p>
      <div class="hero-ctas">
        <PlatformButtons />
        <a class="btn btn-ghost" href={u('/docs#getting-started')}>Read the getting-started guide</a>
      </div>
      <PlatformNote />
    </div>
  </div>
</section>
