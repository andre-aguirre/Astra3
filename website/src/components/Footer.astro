---
import { CONFIG, platformNames } from '../config';
import { u } from '../lib/url';
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a class="brand" href={u('/')}><img src={u('/img/logo-256.png')} alt="" width="28" height="28" />Astra3</a>
        <p>Structural Analysis Toolkit for PDB Rendering Automation. A desktop toolkit for reproducible structure comparison, visualization and reporting, built on PyMOL.</p>
      </div>
      <div><h4>Product</h4><ul><li><a href={u('/features')}>Features</a></li><li><a href={u('/download')}>Download</a></li><li><a href={u('/changelog')}>Changelog</a></li></ul></div>
      <div><h4>Learn</h4><ul><li><a href={u('/docs')}>Documentation</a></li><li><a href={u('/research')}>Research</a></li><li><a href={u('/about')}>About</a></li></ul></div>
      <div><h4>Project</h4><ul><li><a href={CONFIG.githubUrl} target="_blank" rel="noopener">GitHub</a></li><li><a href={`mailto:${CONFIG.contactEmail}`}>Contact</a></li><li><a href={u('/privacy')}>Privacy</a></li></ul></div>
    </div>
    <div class="foot-base"><span>© 2026 Andre Aguirre · MIT License</span><span>Astra3 {CONFIG.version} · {platformNames}</span></div>
  </div>
</footer>
