---
/** Sparse three-layer star field on a canvas: slow drift, parallax and twinkle at ~30 fps; a single static frame under reduced motion. */
---
<canvas id="stars" aria-hidden="true"></canvas>
<div class="glow" aria-hidden="true"></div>
<script>
  const cv = document.getElementById('stars') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dpr = Math.min(2, devicePixelRatio || 1);
  type Star = { x: number; y: number; layer: number; r: number; ph: number; sp: number; gold: boolean };
  let W = 0, H = 0, stars: Star[] = [];
  function seed() {
    W = innerWidth; H = innerHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round(Math.min(160, (W * H) / 9000));
    stars = Array.from({ length: n }, () => {
      const layer = Math.random() < 0.6 ? 0 : Math.random() < 0.75 ? 1 : 2;
      return { x: Math.random() * W, y: Math.random() * H, layer, r: [0.5, 0.8, 1.2][layer], ph: Math.random() * 6.28, sp: 0.3 + Math.random() * 0.9, gold: Math.random() < 0.12 };
    });
  }
  function draw(now: number) {
    ctx.clearRect(0, 0, W, H);
    const t = now / 1000, sy = scrollY;
    for (const s of stars) {
      const par = [0.02, 0.05, 0.1][s.layer];
      const y = (((s.y - sy * par - t * par * 6) % H) + H) % H;
      const a = reduce ? 0.55 : 0.35 + 0.45 * (0.5 + 0.5 * Math.sin(t * s.sp + s.ph));
      ctx.fillStyle = s.gold ? `rgba(240,195,97,${(a * 0.8).toFixed(3)})` : `rgba(220,226,240,${(a * [0.5, 0.7, 0.9][s.layer]).toFixed(3)})`;
      ctx.beginPath(); ctx.arc(s.x, y, s.r, 0, 7); ctx.fill();
    }
  }
  seed();
  addEventListener('resize', () => { seed(); if (reduce) draw(0); });
  if (reduce) draw(0);
  else {
    let last = 0;
    const loop = (now: number) => { if (now - last > 33) { draw(now); last = now; } requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  }
</script>
