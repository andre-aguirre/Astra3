---
import PlatformButtons from './PlatformButtons.astro';
import { CONFIG, windowsAvailable } from '../config';
import { u } from '../lib/url';
---
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Structural analysis, <em>on the record.</em></h1>
        <p class="lede">Astra3 is a desktop app that compares protein structures, draws them, and writes up what it measured. <span class="hide-phone">Point it at a PDB ID or a local file; it drives PyMOL or ChimeraX, renders the images, and writes a report you can trace back to the coordinates.</span></p>
        <div class="hero-ctas">
          <PlatformButtons />
        </div>
        <div class="hero-meta">
          <span>v{CONFIG.version}</span>
          <span class="hide-phone">{windowsAvailable ? 'macOS 12+ · Windows 10/11' : 'macOS 12+ · Intel and Apple Silicon'}</span>
          <span>Uses PyMOL or ChimeraX</span>
          <span class="hide-wide"><a href={u('/download')}>All downloads →</a></span>
        </div>
      </div>
      <div class="mol" aria-hidden="true">
        <div id="molView" class="mol-view"></div>
        <canvas id="molCanvas" hidden></canvas>
        <i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
        <span class="tick t1">CARTOON</span><span class="tick t2" id="molLabel">PDB 1ERJ · TUP1 WD40 DOMAIN</span>
        <span class="tick t3" id="molCount">01 / 03</span><span class="tick t4">N <b class="dot-n">●</b> → C <b class="dot-c">●</b></span>
      </div>
    </div>
  </div>
</section>
<script>
  import { initMolecule } from '../lib/molecule.js';
  import { initHero3D } from '../lib/hero3d.js';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const view = document.getElementById('molView')!;
  const canvas = document.getElementById('molCanvas') as HTMLCanvasElement;
  const label = document.getElementById('molLabel')!;
  const count = document.getElementById('molCount')!;
  // The 3D cartoon loads once the page is idle; without WebGL, or when the
  // visitor has asked their browser to save data, the Cα trace of the same
  // structure is drawn instead (a few KB rather than the viewer library).
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const start = async () => {
    const ok = !saveData && await initHero3D(view, label, count, import.meta.env.BASE_URL.replace(/\/?$/, '/'), reduce);
    if (!ok) { view.hidden = true; canvas.hidden = false; count.textContent = 'Cα TRACE'; initMolecule(canvas, document.createElement('span'), reduce); }
  };
  ('requestIdleCallback' in window) ? (window as any).requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300);
</script>
