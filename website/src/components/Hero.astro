---
import DownloadButton from './DownloadButton.astro';
import WindowsNote from './WindowsNote.astro';
import { CONFIG } from '../config';
import { u } from '../lib/url';
---
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy" id="heroCopy">
        <p class="eyebrow">Structural biology · Scientific computing</p>
        <h1>Structural analysis, <em>streamlined.</em></h1>
        <p class="lede">Astra3 is a desktop toolkit for structured protein-structure comparison, visualization, and reporting workflows. Point it at a PDB ID or a local file; it drives PyMOL, renders the images, and writes a report you can trace back to the coordinates.</p>
        <div class="hero-ctas">
          <DownloadButton />
          <a class="btn btn-ghost" href={u('/features')}>Explore Astra3</a>
        </div>
        <WindowsNote />
        <div class="hero-meta"><span>v{CONFIG.version}</span><span>macOS 12+</span><span>Apple Silicon</span><span>Requires PyMOL</span></div>
      </div>
      <div class="mol" aria-hidden="true">
        <canvas id="molCanvas"></canvas>
        <i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
        <span class="tick t1">Cα TRACE</span><span class="tick t2">ILLUSTRATION</span>
        <span class="tick t3" id="molAngle">θ 000°</span><span class="tick t4">N ● → C ●</span>
      </div>
    </div>
    <div class="stage" id="stage">
      <figure class="window">
        <div class="window-bar"><i></i><i></i><i></i><span>Astra3 — Home</span></div>
        <img src={u('/img/home-1600.webp')} srcset={`${u('/img/home-800.webp')} 800w, ${u('/img/home-1600.webp')} 1600w`} sizes="(max-width: 1200px) 100vw, 1180px" width="1600" height="860" fetchpriority="high" alt="Astra3 home screen with actions to fetch by ID, run Overlay or Termini, run a batch, and a drop area for local structure files, above a list of recent analyses." />
      </figure>
      <figcaption>Astra3's home screen: fetch a structure by ID, run OVERLAY or TERMINI comparisons, process a batch, or import a local file.</figcaption>
    </div>
  </div>
</section>
<script>
  import { initMolecule } from '../lib/molecule.js';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  initMolecule(document.getElementById('molCanvas'), document.getElementById('molAngle'), reduce);
  const stage = document.getElementById('stage')!;
  const win = stage.querySelector<HTMLElement>('.window')!;
  const copy = document.getElementById('heroCopy')!;
  if (!reduce) {
    const onScroll = () => {
      const r = stage.getBoundingClientRect();
      const t = Math.min(1, Math.max(0, 1 - (r.top - innerHeight * 0.25) / (innerHeight * 0.7)));
      win.style.setProperty('--tilt', (10 * (1 - t)).toFixed(2) + 'deg');
      win.style.setProperty('--sc', (0.96 + 0.04 * t).toFixed(3));
      copy.style.transform = `translateY(${Math.min(scrollY * 0.12, 60)}px)`;
      copy.style.opacity = String(Math.max(0.25, 1 - scrollY / 900));
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }
</script>
