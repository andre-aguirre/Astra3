---
import DownloadButton from './DownloadButton.astro';
import WindowsNote from './WindowsNote.astro';
import { CONFIG } from '../config';
import { u } from '../lib/url';
---
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy" id="heroCopy">
        <p class="eyebrow">Structural biology · Scientific computing</p>
        <h1>Structural analysis, <em>streamlined.</em></h1>
        <p class="lede">Astra3 is a desktop toolkit for structured protein-structure comparison, visualization, and reporting workflows. Point it at a PDB ID or a local file; it drives PyMOL, renders the images, and writes a report you can trace back to the coordinates.</p>
        <div class="hero-ctas">
          <DownloadButton />
          <a class="btn btn-ghost" href={u('/features')}>Explore Astra3</a>
        </div>
        <WindowsNote />
        <div class="hero-meta"><span>v{CONFIG.version}</span><span>macOS 12+</span><span>Apple Silicon</span><span>Requires PyMOL</span></div>
      </div>
      <div class="mol" aria-hidden="true">
        <canvas id="molCanvas"></canvas>
        <i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
        <span class="tick t1">Cα TRACE</span><span class="tick t2">PDB 4AKE · ADENYLATE KINASE</span>
        <span class="tick t3" id="molAngle">θ 000°</span><span class="tick t4">N ● → C ●</span>
      </div>
    </div>
  </div>
</section>
<script>
  import { initMolecule } from '../lib/molecule.js';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  initMolecule(document.getElementById('molCanvas'), document.getElementById('molAngle'), reduce);
  const copy = document.getElementById('heroCopy')!;
  if (!reduce) {
    const onScroll = () => {
      copy.style.transform = `translateY(${Math.min(scrollY * 0.12, 60)}px)`;
      copy.style.opacity = String(Math.max(0.25, 1 - scrollY / 900));
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }
</script>
