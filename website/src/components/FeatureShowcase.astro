---
/** Horizontal feature demonstration: OVERLAY → TERMINI → BATCH → REPORTS. Native swipe on touch, scroll-snap and step buttons on desktop, arrow keys when focused. */
import { u } from '../lib/url';
---
<section class="block" aria-labelledby="h-show" style="padding-top:0">
    <div class="wrap">
      <div class="show-head">
        <div class="reveal"><p class="eyebrow">In practice</p><h2 id="h-show">From a PDB ID to a finished report.</h2></div>
        <div class="show-steps" role="group" aria-label="Jump to feature" id="showSteps">
          <button type="button" data-i="0" aria-pressed="true">SINGLE</button><span class="arrow">→</span>
          <button type="button" data-i="1" aria-pressed="false">OVERLAY</button><span class="arrow">→</span>
          <button type="button" data-i="2" aria-pressed="false">TERMINI</button><span class="arrow">→</span>
          <button type="button" data-i="3" aria-pressed="false">BATCH</button><span class="arrow">→</span>
          <button type="button" data-i="4" aria-pressed="false">REPORTS</button>
        </div>
      </div>
      <div class="track" id="track" tabindex="0" aria-label="Feature demonstrations, scroll horizontally">
        <article class="slide">
          <div class="shot showstage"><div class="stack ring" data-stack><img class="on" loading="lazy" src={u('/img/show/single-1erj-front.webp')} alt="PDB 1ERJ, the seven-bladed WD40 propeller of Tup1, rendered by Astra3" /><img loading="lazy" src={u('/img/show/single-1erj-back.webp')} alt="" /></div><span class="showstage-note">1ERJ · FRONT AND BACK VIEWS</span></div>
          <div class="body">
            <span class="num">01 / 05 · SINGLE STRUCTURE</span>
            <h3>One ID in, a full analysis out.</h3>
            <p>Astra3 fetches the entry, removes water, colours every chain, ligand and ion, marks both termini, renders six views and writes the report and session, the same way every time.</p>
            <ul class="specs"><li>Six transparent, ray-traced views at the quality you choose</li><li>N-terminus in green, C-terminus in red</li><li>A finished <span class="mono">.pse</span> session to keep working in</li></ul>
            <code>1ERJ -excellent</code>
            <a class="more" href={u('/docs#getting-started')}>Getting started →</a>
          </div>
        </article>
        <article class="slide" style="--pos:50% 0">
          <div class="shot showstage"><div class="stack" data-stack><img class="on" loading="lazy" src={u('/img/show/overlay-1xgd-6f7r-front.webp')} alt="1XGD (grey, reference) and 6F7R (blue) aligned by Astra3 OVERLAY, front view" /><img loading="lazy" src={u('/img/show/overlay-1xgd-6f7r-back.webp')} alt="" /></div><span class="showstage-note">1XGD <b class="k-ref">■</b> REFERENCE · 6F7R <b class="k-cmp">■</b> · FRONT AND BACK</span></div>
          <div class="body">
            <span class="num">02 / 05 · OVERLAY</span>
            <h3>Align structures on a shared reference.</h3>
            <p>Sequence-guided structural superposition through PyMOL's <span class="mono">cmd.align</span>. The reference is chosen automatically (fewest bound ligands) or set by you, and the choice is recorded in the report.</p>
            <ul class="specs"><li>RMSD per structure, aligned atoms and residues</li><li>C-alpha pairwise RMSD matrix across every structure</li><li>Six views of all structures together and of each comparison</li></ul>
            <code>OVERLAY 1XGD 6F7R</code>
            <a class="more" href={u('/docs#overlay')}>OVERLAY documentation →</a>
          </div>
        </article>
        <article class="slide" style="--pos:50% 0">
          <div class="shot showstage"><div class="ends" data-ends>
            <figure class="end end-n"><img class="on" loading="lazy" src={u('/img/show/termini-nterm-1.webp')} alt="N-terminus close-up with the reference and comparison terminal projection vectors" /><img loading="lazy" src={u('/img/show/termini-nterm-2.webp')} alt="" /><figcaption>N-TERMINUS</figcaption></figure>
            <figure class="end end-c"><img class="on" loading="lazy" src={u('/img/show/termini-cterm-1.webp')} alt="C-terminus close-up with the reference and comparison terminal projection vectors" /><img loading="lazy" src={u('/img/show/termini-cterm-2.webp')} alt="" /><figcaption>C-TERMINUS</figcaption></figure>
          </div><span class="showstage-note">CLOSE-UP RENDERS · TWO ANGLES PER TERMINUS</span></div>
          <div class="body">
            <span class="num">03 / 05 · TERMINI</span>
            <h3>See how the ends of a chain move.</h3>
            <p>After alignment, each N- and C-terminus is measured independently against the reference. When termini don't line up, Astra3 shows a before/after and asks. Nothing changes without approval.</p>
            <ul class="specs"><li>Tip and centroid displacement (Å), orientation change</li><li>Terminal Projection Vector angle, local terminal RMSD</li><li>Close-up renders of the terminus vectors</li></ul>
            <code>TERMINI 1HEW 1LYZ -skipcloseup</code>
            <a class="more" href={u('/docs#termini')}>TERMINI documentation →</a>
          </div>
        </article>
        <article class="slide" style="--pos:50% 0">
          <div class="shot showstage"><div class="fan" data-fan><figure class="card" style="--i:0"><img loading="lazy" src={u('/img/show/batch-1hew.webp')} alt="PDB 1HEW rendered by Astra3" /><figcaption><span>✓</span>1HEW</figcaption></figure><figure class="card" style="--i:1"><img loading="lazy" src={u('/img/show/batch-4hhe.webp')} alt="PDB 4HHE rendered by Astra3" /><figcaption><span>✓</span>4HHE</figcaption></figure><figure class="card" style="--i:2"><img loading="lazy" src={u('/img/show/batch-4ake.webp')} alt="PDB 4AKE rendered by Astra3" /><figcaption><span>✓</span>4AKE</figcaption></figure><figure class="card" style="--i:3"><img loading="lazy" src={u('/img/show/batch-1ake.webp')} alt="PDB 1AKE rendered by Astra3" /><figcaption><span>✓</span>1AKE</figcaption></figure></div><span class="showstage-note">ONE QUEUE · FOUR STRUCTURES · SAME REPORTS AND IMAGES FOR EACH</span></div>
          <div class="body">
            <span class="num">04 / 05 · BATCH</span>
            <h3>Queue a list and walk away.</h3>
            <p>IDs are normalised and deduplicated, each structure gets its own output folder, and redundant chains can be handled by a rule you set in advance, so the run never pauses for input.</p>
            <ul class="specs"><li>IDs inline or from a text file, one per line</li><li><span class="mono">-alwaysreduce</span>, <span class="mono">-keephomomers</span>, <span class="mono">-reducepriority</span></li><li>Cancel stops the whole queue</li></ul>
            <code>BATCH 1HEW 4HHE 4AKE 1AKE -alwaysreduce</code>
            <a class="more" href={u('/docs#batch')}>BATCH documentation →</a>
          </div>
        </article>
        <article class="slide" style="--pos:50% 0">
          <div class="shot rcard-wrap"><figure class="rcard" aria-label="Excerpt of an Astra3 report for PDB entry 1ERJ">
            <header><span class="rc-id">1ERJ · chain C</span><span class="rc-sub">Tup1 C-terminal domain · X-ray · 2.30 Å</span></header>
            <div class="rc-grid">
              <div><b>9.27</b><span>Clashscore</span></div>
              <div><b>0.10%</b><span>Ramachandran outliers</span></div>
              <div><b>2.01%</b><span>Rotamer outliers</span></div>
              <div><b>0.228 / 0.266</b><span>R-work / R-free</span></div>
              <div><b>0.265</b><span>R-free, wwPDB (DCC)</span></div>
              <div><b>357</b><span>Resolved residues</span></div>
            </div>
            <dl class="rc-rows">
              <div><dt>Missing</dt><dd>281-282, 385-388C, 432-441, 607-620, 711-713 <em>(36)</em></dd></div>
              <div><dt>Construct</dt><dd>P16649 389-431 deleted by design, not unobserved</dd></div>
              <div><dt>Domains</dt><dd>Pfam WD40 ×5 · CATH 2.130.10.10 · SCOPe · SCOP2</dd></div>
            </dl>
            <p class="rc-warn"><span>!</span>N-terminus window has steric clashes: Leu285, Val286, Asn289, Gln290</p>
            <figcaption>Values from an Astra3 1.9.0 run on PDB 1ERJ; validation data from the wwPDB validation report.</figcaption>
          </figure></div>
          <div class="body">
            <span class="num">05 / 05 · REPORTS</span>
            <h3>Reports that explain what changed, and why.</h3>
            <p>A self-contained HTML report, a text report and a JSON export, built from the same analysis. Info icons explain each value; a Methods paragraph is ready to paste.</p>
            <ul class="specs"><li>Validation outliers, reference sequence, mutations, domains</li><li>Unavailable values written as <span class="mono">null</span>, never 0</li><li>Optional CSV with <span class="mono">-csv</span></li></ul>
            <code>1HEW -excellent -csv</code>
            <a class="more" href={u('/docs#reports')}>Reports documentation →</a>
          </div>
        </article>
      </div>
    </div>
  </section>
<script>
  const track = document.getElementById('track')!;
  const steps = [...document.querySelectorAll<HTMLButtonElement>('#showSteps button')];
  const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const go = (i: number) => track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
  steps.forEach((b) => b.addEventListener('click', () => go(+b.dataset.i!)));
  const io = new IntersectionObserver((ents) => ents.forEach((en) => {
    if (en.isIntersecting && en.intersectionRatio > 0.6) {
      const i = slides.indexOf(en.target as HTMLElement);
      steps.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
    }
  }), { root: track, threshold: [0.6] });
  slides.forEach((s) => io.observe(s));

  // Scroll-linked motion for the rendered structures: views cross-fade and
  // the termini drift apart slowly as the section passes through the window.
  const section = track.closest('section')!;
  const stacks = [...section.querySelectorAll<HTMLElement>('[data-stack]')];
  const ends = [...section.querySelectorAll<HTMLElement>('[data-ends]')];
  const setOn = (imgs: HTMLElement[], k: number) => imgs.forEach((im, j) => im.classList.toggle('on', j === k));
  let ticking = false;
  const update = () => {
    ticking = false;
    const r = section.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
    section.style.setProperty('--p', p.toFixed(4));
    for (const st of stacks) {
      const imgs = [...st.querySelectorAll<HTMLElement>('img')];
      setOn(imgs, Math.min(imgs.length - 1, Math.floor(p * imgs.length)));
    }
    for (const en of ends) en.querySelectorAll<HTMLElement>('figure').forEach((f) => setOn([...f.querySelectorAll<HTMLElement>('img')], p < 0.8 ? 0 : 1));
  };
  if (!reduce) {
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
  track.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    e.preventDefault();
    track.scrollBy({ left: (e.key === 'ArrowRight' ? 1 : -1) * slides[0].offsetWidth, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
