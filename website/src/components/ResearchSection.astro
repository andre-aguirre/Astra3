---
/** Citation block with APA / BibTeX / CFF tabs and a copy button. */
import { CONFIG } from '../config';
const v = CONFIG.version;
const formats: Record<string, string> = {
  APA: `Aguirre, A. (2026). Astra3: Structural Analysis Toolkit for PDB Rendering Automation (Version ${v}) [Computer software]. ${CONFIG.githubUrl}`,
  BibTeX: `@software{aguirre_astra3_2026,\n  author  = {Aguirre, Andre},\n  title   = {Astra3: Structural Analysis Toolkit for PDB Rendering Automation},\n  year    = {2026},\n  version = {${v}},\n  license = {MIT},\n  url     = {${CONFIG.githubUrl}}\n}`,
  CFF: `cff-version: 1.2.0\ntitle: "Astra3: Structural Analysis Toolkit for PDB Rendering Automation"\ntype: software\nauthors:\n  - family-names: "Aguirre"\n    given-names: "Andre"\nversion: "${v}"\nrepository-code: "${CONFIG.githubUrl}"\nlicense: "MIT"`,
};
const keys = Object.keys(formats);
const uid = `cite-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="cite" data-cite data-formats={JSON.stringify(formats)}>
  <blockquote>Aguirre, A. (2026). <i>Astra3: Structural Analysis Toolkit for PDB Rendering Automation</i> [Computer software]. <a href={CONFIG.githubUrl} target="_blank" rel="noopener" style="color:var(--accent-bright)">github.com/andre-aguirre/Astra3</a></blockquote>
  <div class="tabs" role="tablist" aria-label="Citation format">
    {keys.map((k, i) => <button type="button" role="tab" id={`${uid}-${i}`} aria-controls={`${uid}-panel`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-k={k}>{k}</button>)}
  </div>
  <pre class="mono" role="tabpanel" id={`${uid}-panel`} aria-labelledby={`${uid}-0`} tabindex="0">{formats.APA}</pre>
  <button class="btn btn-ghost btn-sm copy" type="button">Copy citation</button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-cite]').forEach((el) => {
    const fmts = JSON.parse(el.dataset.formats!) as Record<string, string>;
    let cur = 'APA';
    const pre = el.querySelector('pre')!;
    const tabs = el.querySelectorAll<HTMLButtonElement>('[role=tab]');
    const select = (b: HTMLButtonElement, focus = false) => {
      cur = b.dataset.k!;
      tabs.forEach((x) => { const on = x === b; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; });
      pre.textContent = fmts[cur];
      pre.setAttribute('aria-labelledby', b.id);
      if (focus) b.focus();
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => select(b));
      // Arrow keys, Home and End move between formats (WAI-ARIA tabs pattern).
      b.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const to = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
        if (to < 0) return;
        e.preventDefault(); select(tabs[to], true);
      });
    });
    const copy = el.querySelector<HTMLButtonElement>('.copy')!;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(fmts[cur]); copy.textContent = 'Copied'; }
      catch { copy.textContent = 'Select the text to copy'; }
      setTimeout(() => (copy.textContent = 'Copy citation'), 1800);
    });
  });
</script>
