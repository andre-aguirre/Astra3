---
/** One line under the hero and the closing call to action: licence, the one requirement, and the full download page. */
import { CONFIG, windowsAvailable } from '../config';
import { u } from '../lib/url';
const w = CONFIG.platforms.windows;
---
<p class="win-note">
  {windowsAvailable
    ? <span>Free and open source (GPL-3.0) · Requires PyMOL · <a href={u('/download')}>All download options and requirements</a></span>
    : <span><strong style="color:var(--text-0);font-weight:600">{w.name} · Coming soon.</strong> Microsoft Store certification in progress. <a href={u('/download')}>Download options</a></span>}
</p>
