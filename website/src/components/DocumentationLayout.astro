---
/** Docs shell: sticky sidebar on desktop, collapsible "On this page" menu on mobile, active-section tracking and a thin reading-progress bar. */
interface Section { id: string; group: string; title: string }
interface Props { sections: Section[] }
const { sections } = Astro.props;
const groups = [...new Set(sections.map((s) => s.group))].map((g) => ({ g, items: sections.filter((s) => s.group === g) }));
---
<div class="wrap">
  <details class="docnav-m" id="docnavM">
    <summary>On this page</summary>
    <nav class="docnav" aria-label="Documentation (mobile)">
      {groups.map(({ g, items }) => (<><h4>{g}</h4><ul>{items.map((s) => <li><a href={`#${s.id}`} data-doc={s.id}>{s.title}</a></li>)}</ul></>))}
    </nav>
  </details>
  <div class="docs">
    <nav class="docnav" aria-label="Documentation">
      {groups.map(({ g, items }) => (<><h4>{g}</h4><ul>{items.map((s) => <li><a href={`#${s.id}`} data-doc={s.id}>{s.title}</a></li>)}</ul></>))}
    </nav>
    <article class="doc"><slot /></article>
  </div>
</div>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-doc]')];
  const io = new IntersectionObserver((ents) => ents.forEach((en) => {
    if (en.isIntersecting) links.forEach((a) => a.classList.toggle('active', a.dataset.doc === en.target.id));
  }), { rootMargin: '-30% 0px -60% 0px' });
  document.querySelectorAll('.doc section').forEach((s) => io.observe(s));
  const m = document.getElementById('docnavM') as HTMLDetailsElement;
  m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (m.open = false)));
  const bar = document.getElementById('progress')!;
  bar.hidden = false;
  const onScroll = () => {
    const h = document.documentElement;
    bar.style.width = ((h.scrollTop / Math.max(1, h.scrollHeight - innerHeight)) * 100).toFixed(2) + '%';
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>
