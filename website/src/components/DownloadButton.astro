---
/** Platform-aware button. A platform that is not yet available renders a disabled "Coming soon" control, never a link. */
import { CONFIG, macDownloadUrl } from '../config';
import { ICON } from '../lib/icons';
interface Props { platform?: 'macos' | 'windows'; size?: 'sm' | 'md'; label?: string; icon?: boolean }
const { platform = 'macos', size = 'md', label, icon = true } = Astro.props;
const p = CONFIG.platforms[platform];
const sm = size === 'sm' ? ' btn-sm' : '';
const url = platform === 'macos' ? macDownloadUrl : CONFIG.platforms.windows.url;
const text = label ?? (platform === 'macos' ? 'Download for macOS' : 'Get it from Microsoft');
---
{p.status === 'available' && url
  ? <a class={`btn btn-primary${sm}`} href={url} target="_blank" rel="noopener">{icon && <Fragment set:html={platform === 'macos' ? ICON.apple : ICON.windows} />}{text}</a>
  : <span class={`btn is-disabled${sm}`} role="button" aria-disabled="true"><Fragment set:html={ICON.windows} />Coming soon</span>}
