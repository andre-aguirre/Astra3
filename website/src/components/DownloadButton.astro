---
/**
 * Download button.
 *   platform="macos" | "windows"  links straight to that platform's download;
 *                                  a platform that is not available renders a
 *                                  disabled "Coming soon" control, never a link.
 *   platform="any"                 links to the site's Download page, where the
 *                                  visitor chooses a platform (used in the navbar).
 */
import { CONFIG, macDownloadUrl } from '../config';
import { ICON } from '../lib/icons';
import { u } from '../lib/url';
interface Props { platform?: 'macos' | 'windows' | 'any'; size?: 'sm' | 'md'; label?: string; icon?: boolean; variant?: 'primary' | 'ghost' }
const { platform = 'macos', size = 'md', label, icon = true, variant = 'primary' } = Astro.props;
const sm = size === 'sm' ? ' btn-sm' : '';
const cls = `btn btn-${variant}${sm}`;
const p = platform === 'any' ? null : CONFIG.platforms[platform];
const url = platform === 'macos' ? macDownloadUrl : platform === 'windows' ? CONFIG.platforms.windows.url : null;
const text = label ?? (platform === 'windows' ? 'Get it from Microsoft' : platform === 'macos' ? 'Download for macOS' : 'Download');
const aria = platform === 'windows' ? 'Get Astra3 from the Microsoft Store' : platform === 'macos' ? 'Download Astra3 for macOS from GitHub Releases' : undefined;
---
{platform === 'any'
  ? <a class={cls} href={u('/download')}>{text}</a>
  : p && p.status === 'available' && url
    ? <a class={cls} href={url} target="_blank" rel="noopener" data-platform={platform} aria-label={label ? undefined : aria}>{icon && <Fragment set:html={platform === 'macos' ? ICON.apple : ICON.windows} />}{text}</a>
    : <span class={`btn is-disabled${sm}`} role="button" aria-disabled="true" data-platform={platform}><Fragment set:html={platform === 'macos' ? ICON.apple : ICON.windows} />{p?.name} · Coming soon</span>}
