---
// Fonts are bundled with the site rather than loaded from a font service,
// so a visit makes no request to anyone but the site's host.
import '@fontsource-variable/inter/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StarField from '../components/StarField.astro';
import PageTransition from '../components/PageTransition.astro';
import { u } from '../lib/url';

interface Props { title: string; description: string; current?: string; jsonLd?: object }
const { title, description, current = '', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u('/og-image.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0F1216" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Astra3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <StarField />
    <div id="progress" hidden></div>
    <div class="shell">
      <Navbar current={current} />
      <main id="main" tabindex="-1"><PageTransition><slot /></PageTransition></main>
      <Footer />
    </div>
  </body>
</html>
