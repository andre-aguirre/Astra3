---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformCard from '../components/PlatformCard.astro';
import { CONFIG, windowsAvailable, platformNames } from '../config';
import { u } from '../lib/url';
const win = CONFIG.platforms.windows;
---
<BaseLayout title={`Download Astra3 for ${platformNames}`} description={`Download Astra3 for macOS (universal: Intel and Apple Silicon, macOS 10.15+). ${windowsAvailable ? 'Windows 10 and 11 through the Microsoft Store.' : 'The Windows version is in Microsoft Store certification.'}`} current="download">
<header class="page-head"><div class="wrap"><p class="eyebrow">Download</p><h1>Install Astra3.</h1><p class="lede">Choose your platform. Astra3 needs only PyMOL, installed separately; open-source and Incentive PyMOL both work.</p></div></header>
  <div class="wrap">
    <div class="plats dl-plats">
      <PlatformCard platform="macos" />
      <PlatformCard platform="windows" />
    </div>
    <div class="plats dl-plats" style="padding-top:0">
      <div class="panel" id="install-macos">
        <h3>Install on macOS</h3>
        <ol class="steps">
          <li>Download the latest <strong>.dmg</strong> (or the <strong>.zip</strong>, which holds the same signed app) from GitHub Releases.</li>
          <li>Open the <strong>.dmg</strong>.</li>
          <li>Drag <strong>Astra3</strong> into your <strong>Applications</strong> folder.</li>
          <li>Launch Astra3 and select your PyMOL installation if it isn't found automatically.</li>
        </ol>
        <p class="muted">Astra3 is Developer ID signed and notarized by Apple, so no Gatekeeper override is required. One download runs natively on both Intel and Apple Silicon Macs.</p>
      </div>
      {windowsAvailable ? (
        <div class="panel" id="install-windows">
          <h3>Install on Windows</h3>
          <ol class="steps">
            <li>Open the <a href={win.url!} target="_blank" rel="noopener">Astra3 page in the Microsoft Store</a> and choose <strong>Get</strong>.</li>
            <li>Open <strong>Astra3</strong> from the Start menu.</li>
            <li>Select your PyMOL installation if it isn't found automatically.</li>
          </ol>
          <p class="muted">The Microsoft Store installs Astra3 and delivers its updates. PyMOL runs hidden in the background; its window only opens when you choose Open Session on a finished run.</p>
        </div>
      ) : (
        <div class="panel" id="install-windows">
          <h3>Windows</h3>
          <p class="muted">The Windows version is in Microsoft Store certification. This page will link to it as soon as it is available.</p>
        </div>
      )}
    </div>
    <div class="plats dl-plats" style="padding-top:0">
      <div class="panel">
        <h3>If something needs attention on macOS</h3>
        <p class="muted"><strong style="color:var(--text-0)">Folder permission.</strong> If your output folder is on the Desktop, Documents or Downloads, macOS asks once for permission. If it was denied, grant it in System Settings → Privacy &amp; Security → Files and Folders.</p>
        <p class="muted"><strong style="color:var(--text-0)">PyMOL not found.</strong> Use Browse in the setup dialog or Settings → PyMOL and pick <span class="mono">PyMOL.app</span> itself. Astra3 resolves the executable inside it and checks that it really is PyMOL.</p>
        <p class="muted"><strong style="color:var(--text-0)">Older PyMOL on an Apple Silicon Mac.</strong> A PyMOL built only for Intel Macs needs Apple's Rosetta. Astra3 says so if Rosetta is missing; install it with <span class="mono">softwareupdate --install-rosetta</span> in Terminal, or install a current PyMOL.</p>
      </div>
      {windowsAvailable && (
        <div class="panel">
          <h3>If something needs attention on Windows</h3>
          <p class="muted"><strong style="color:var(--text-0)">PyMOL not found.</strong> Use Browse in the setup dialog or Settings → PyMOL. The usual locations are <span class="mono">%LOCALAPPDATA%\Schrodinger\PyMOL2\PyMOLWin.exe</span> and <span class="mono">C:\Program Files\PyMOL\PyMOLWin.exe</span>.</p>
          <p class="muted"><strong style="color:var(--text-0)">Unusual PyMOL layouts.</strong> Astra3 runs PyMOL through the Python that ships next to <span class="mono">PyMOLWin.exe</span>. If it reports that Python cannot be found, select <span class="mono">python.exe</span> from your PyMOL folder instead.</p>
          <p class="muted"><strong style="color:var(--text-0)">Where results go.</strong> By default, <span class="mono">Astra3\Protein_outputs</span> in your user folder. You can choose another folder in Settings.</p>
        </div>
      )}
    </div>
    <div class="panel" style="margin-bottom:24px">
      <h3>Source and releases</h3>
      <ul class="doclinks" style="margin-top:4px">
        <li><a href={CONFIG.githubUrl} target="_blank" rel="noopener">GitHub repository <span>andre-aguirre/Astra3</span></a></li>
        <li><a href={CONFIG.latestReleaseUrl} target="_blank" rel="noopener">Latest macOS release notes <span>GITHUB</span></a></li>
        <li><a href={CONFIG.releasesUrl} target="_blank" rel="noopener">Previous macOS releases <span>ALL VERSIONS</span></a></li>
        {windowsAvailable && <li><a href={win.url!} target="_blank" rel="noopener">Astra3 for Windows <span>MICROSOFT STORE</span></a></li>}
        <li><a href={u('/changelog')}>Changelog <span>THIS SITE</span></a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
