---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import VideoSection from '../components/VideoSection.astro';
import PlatformCard from '../components/PlatformCard.astro';
import ResearchSection from '../components/ResearchSection.astro';
import CTA from '../components/CTA.astro';
import { CONFIG, windowsAvailable, platformNames } from '../config';
import { u } from '../lib/url';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Astra3',
  alternateName: CONFIG.fullName,
  applicationCategory: 'ScientificApplication',
  operatingSystem: windowsAvailable ? ['macOS 10.15 or later (Intel and Apple Silicon)', 'Windows 10 or later (64-bit)'] : 'macOS 10.15 or later (Intel and Apple Silicon)',
  softwareVersion: CONFIG.version,
  softwareRequirements: 'PyMOL (open-source or Incentive), installed separately',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  downloadUrl: new URL(u('/download'), Astro.site).href,
  codeRepository: CONFIG.githubUrl,
  author: { '@type': 'Person', name: 'Andre Aguirre' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout title="Astra3 — Structural Analysis, Streamlined" description={`Astra3 is a desktop toolkit for structured protein-structure comparison, visualization, and reporting workflows, built on PyMOL. Download for ${platformNames}.`} jsonLd={jsonLd}>
<Hero />
<section class="block" aria-labelledby="h-what">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">What Astra3 does</p>
        <h2 id="h-what">A reliable structural analysis assistant.</h2>
        <p class="lede">The same twenty PyMOL commands, run the same way every time. Astra3 fetches or loads a structure, cleans it, colours and labels it deterministically, renders a full set of images and writes reports that say exactly what it found, and what it did not.</p>
        <p class="pull"><strong>Astra3 does not replace PyMOL.</strong> It runs its analysis inside your own copy of PyMOL, open-source or Incentive, and saves a finished <span class="mono">.pse</span> session you can keep working in.</p>
      </div>
      <ul class="rules reveal" aria-label="Design rules">
        <li><b>Scientific accuracy</b><p>Values are read from PyMOL, computed from atomic coordinates, or parsed from the file's own header records.</p></li>
        <li><b>Reproducibility</b><p>The same structure and command give the same colouring, selections, session and report. Reports record the exact options used.</p></li>
        <li><b>Known vs. unavailable</b><p>When something cannot be determined, the report explicitly says so.</p></li>
        <li><b>No fabricated conclusions</b><p>Contacts are reported as geometry: a close N/O pair is listed as a possible polar contact.</p></li>
        <li><b>Consistent exports</b><p>HTML, TXT, JSON and CSV come from one result set, so they always agree.</p></li>
      </ul>
    </div>
  </section>
<section class="block" aria-labelledby="h-feat" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Feature overview</p><h2 id="h-feat">Compare structures. Inspect termini. Process many at once.</h2></div>
      <div class="fgrid reveal">
        <a href={u('/features#overlay')}><span class="tag">OVERLAY</span><h3>Multi-structure alignment</h3><p>Align two or more structures onto a shared reference, with RMSD, aligned atom and residue counts, and a full pairwise RMSD matrix.</p><span class="go">Read more →</span></a>
        <a href={u('/features#termini')}><span class="tag">TERMINI</span><h3>Terminus comparison</h3><p>Measure how N- and C-termini move and reorient after alignment: displacement, rotation and local RMSD, with close-up renders.</p><span class="go">Read more →</span></a>
        <a href={u('/features#batch')}><span class="tag">BATCH</span><h3>Unattended queues</h3><p>Process a list of IDs or a batch file one after another, with the same reports and images for each. One failure never stops the run.</p><span class="go">Read more →</span></a>
        <a href={u('/features#related')}><span class="tag">RELATED · NEW IN 1.9</span><h3>Related Structures</h3><p>Find every experimental entry of the same protein, with method, resolution, ligands, mutations and coverage, and warnings before you run.</p><span class="go">Read more →</span></a>
        <a href={u('/features#viewer')}><span class="tag">3D VIEWER</span><h3>Interactive viewer</h3><p>Inspect results in a built-in 3D viewer with per-chain, ligand and ion colour, representation and visibility controls.</p><span class="go">Read more →</span></a>
        <a href={u('/features#reports')}><span class="tag">HTML · TXT · JSON · CSV</span><h3>Structured reports</h3><p>Self-contained HTML reports with info icons and colour keys, a ready-to-paste Methods paragraph, and machine-readable exports.</p><span class="go">Read more →</span></a>
      </div>
    </div>
  </section>
<FeatureShowcase />
<section class="block" aria-labelledby="h-flow" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Workflow</p><h2 id="h-flow">What happens to every structure, in order.</h2><p class="lede">The same nine steps, whether you run one ID or a queue of fifty.</p></div>
      <ol class="pipe reveal">
        <li><b>Fetch or load</b><p>By PDB ID in legacy PDB or mmCIF, with automatic fallback, or from a local <span class="mono">.pdb</span>, <span class="mono">.cif</span> or <span class="mono">.pse</span>.</p></li>
        <li><b>Remove water</b><p>Water molecules are stripped before analysis.</p></li>
        <li><b>Colour and name</b><p>Every chain, ligand and ion gets the same colour across a run, so figures stay consistent.</p></li>
        <li><b>Mark the termini</b><p>N- and C-terminal residues of every protein chain are selected and coloured.</p></li>
        <li><b>Ligand environment</b><p>Residues within 4.0 Å and possible polar contacts within 3.5 Å, from PyMOL's own geometry.</p></li>
        <li><b>Redundant chains</b><p>Homomers are detected; keep one representative chain or all of them.</p></li>
        <li><b>Save the session</b><p>A finished <span class="mono">.pse</span>, plus a plain <span class="mono">.pdb</span> for the viewer.</p></li>
        <li><b>Render six views</b><p>Front, back, left, right, top and bottom, transparent background, at the quality you choose.</p></li>
        <li><b>Write reports</b><p>HTML, TXT and JSON (and CSV on request) from one result set.</p></li>
      </ol>
    </div>
  </section>
<VideoSection />
<section class="block hide-phone" aria-labelledby="h-plat" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Platform availability</p><h2 id="h-plat">{windowsAvailable ? 'On macOS and Windows.' : 'Built for macOS today. Windows is on its way.'}</h2>{windowsAvailable && <p class="lede">The same analyses, reports and results on both, with PyMOL doing the work in the background.</p>}</div>
      <div class="plats"><PlatformCard platform="macos" /><PlatformCard platform="windows" /></div>
    </div>
  </section>
<section class="block" aria-labelledby="h-docs" style="padding-top:0">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Documentation</p>
        <h2 id="h-docs">Every command, in the interface and the console.</h2>
        <p class="lede">The same commands run from the interface and the built-in console, with identical output. Type <span class="mono">-help</span> at any time for the full reference.</p>
        <ul class="doclinks" style="margin-top:28px">
          <li><a href={u('/docs#getting-started')}>Getting started <span>01</span></a></li>
          <li><a href={u('/docs#overlay')}>OVERLAY <span>CMD</span></a></li>
          <li><a href={u('/docs#importing')}>Importing structures <span>IMPORT</span></a></li>
          <li><a href={u('/docs#termini')}>TERMINI <span>CMD</span></a></li>
          <li><a href={u('/docs#reports')}>Reports <span>HTML</span></a></li>
          <li><a href={u('/docs#batch')}>BATCH <span>CMD</span></a></li>
        </ul>
      </div>
      <div class="term reveal hide-phone" aria-label="Example console session">
        <div class="window-bar"><i></i><i></i><i></i><span>Astra3 console</span></div>
<pre><span class="c"># single structure, medium quality, with CSV</span>
<span class="p">Enter a PDB ID (or -help):</span> 1ABC -medium -csv

<span class="c"># align three structures, choose the reference</span>
<span class="p">Enter a PDB ID (or -help):</span> <span class="k">OVERLAY</span> 1XGD 6F7R -reference1XGD

<span class="c"># compare termini against a reference</span>
<span class="p">Enter a PDB ID (or -help):</span> <span class="k">TERMINI</span> 1XGD 6F7R 4JIR

<span class="c"># process a file of IDs, never prompt for chains</span>
<span class="p">Enter a PDB ID (or -help):</span> <span id="typeLine" data-keyword="BATCH" data-rest=" batch.txt -alwaysreduce"><span class="k">BATCH</span> batch.txt -alwaysreduce</span><span class="caret" aria-hidden="true"></span></pre>
      </div>
    </div>
  </section>
<section class="block" aria-labelledby="h-cite" style="padding-top:0">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Research &amp; citation</p>
        <h2 id="h-cite">Traceable numbers, ready for a methods section.</h2>
        <p class="lede">Every report ends with a Methods paragraph with references, saved as <span class="mono">Methods.txt</span>, and every piece of outside data a report used is saved with the run.</p>
        <p style="margin-top:24px"><a class="btn btn-ghost" href={u('/research')}>Research &amp; citation →</a></p>
      </div>
      <div class="reveal hide-phone"><ResearchSection /></div>
    </div>
  </section>
<CTA />
</BaseLayout>

<script>
  // The console's last command types itself out as the box scrolls into view
  // (and un-types if you scroll back up). Reduced motion shows it complete.
  const line = document.getElementById('typeLine');
  if (line && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const kw = line.dataset.keyword || '';
    const rest = line.dataset.rest || '';
    const full = kw + rest;
    const box = line.closest('pre')!;
    let shown = -1;
    const render = (n: number) => {
      if (n === shown) return;
      shown = n;
      const k = Math.min(n, kw.length);
      line.innerHTML = (k ? `<span class="k">${kw.slice(0, k)}</span>` : '') + rest.slice(0, Math.max(0, n - kw.length));
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = box.getBoundingClientRect();
      // 0 when the box's bottom enters the window, 1 by the time it reaches the middle.
      const p = Math.min(1, Math.max(0, (innerHeight - r.bottom) / (innerHeight * 0.5)));
      render(Math.round(p * full.length));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

